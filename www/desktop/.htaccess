# Desktop app releases: latest.json (the updater manifest) and {version}/{file} installers,
# uploaded by the frontend repository's CI. Served as static files, never by index.php.
<IfModule mod_headers.c>
	Header set Access-Control-Allow-Origin "*"
	Header set Access-Control-Allow-Methods "GET, OPTIONS"
	Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# disable directory listing
<IfModule mod_autoindex.c>
	Options -Indexes
</IfModule>

# installers and signatures are downloads, whatever the server's MIME table says
AddType application/octet-stream .exe .msi .AppImage .deb .rpm .dmg .sig .gz
# never Content-Encoding: gzip on .tar.gz bundles, or clients unpack them and the signature fails
RemoveEncoding .gz

# the manifest changes in place on every release, so clients must revalidate it
<IfModule mod_headers.c>
	<FilesMatch "^latest\.json$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</IfModule>
