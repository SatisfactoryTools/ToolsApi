search:
	controllers:
		in: %appDir%/Modules
		classes:
			- *Controller
	model:
		in: %appDir%/Model
		classes:
			- *Repository
			- *Facade

services:
	- greeny\SatisfactoryTools\Api\Model\NullableTypedFieldMapper

	- Tracy\Bridges\Psr\TracyToPsrLoggerAdapter

	- greeny\SatisfactoryTools\Api\Model\Services\CustomVersionDataGenerator(%appDir%/../www)

	- greeny\SatisfactoryTools\Api\Model\Services\CustomVersionFileService(
		wwwDir: %appDir%/../www,
		lockDir: %tempDir%/locks
	)

	- greeny\SatisfactoryTools\Api\Model\Services\ModDataStorage(%appDir%/../www)

	- greeny\SatisfactoryTools\Api\Model\Services\HelpImageStorage(%appDir%/../www)

	- greeny\SatisfactoryTools\Api\Model\Services\HelpSnapshotService(
		wwwDir: %appDir%/../www,
		lockDir: %tempDir%/locks
	)

	- greeny\SatisfactoryTools\Api\Model\Services\PlanTreeBuilder

	- greeny\SatisfactoryTools\Api\Model\Services\PlannerFingerprint

	- greeny\SatisfactoryTools\Api\Model\Services\OfficialVersionRegistry(wwwDir: %appDir%/../www)

	- greeny\SatisfactoryTools\Api\Model\Services\Meta\VersionMetaIndex(wwwDir: %appDir%/../www)

	- greeny\SatisfactoryTools\Api\Model\Services\Meta\MetaResolver(
		wwwDir: %appDir%/../www,
		publicApiUrl: %publicApiUrl%
	)

	- greeny\SatisfactoryTools\Api\Model\Services\PlanLinkService

	- greeny\SatisfactoryTools\Api\Model\Services\ShareService

	- greeny\SatisfactoryTools\Api\Model\Services\LegacyShareFetcher(sourceUrl: %legacyShareSourceUrl%)

	- greeny\SatisfactoryTools\Api\Model\Legacy\LegacyGameDataLoader(dataDir: %appDir%/../data/legacy)

	- greeny\SatisfactoryTools\Api\Model\Legacy\LPSolver(
		lpSolveBin: %legacySolver.lpSolveBin%,
		timeout: %legacySolver.timeout%
	)

	- greeny\SatisfactoryTools\Api\Model\Legacy\ProductionSolver

	- greeny\SatisfactoryTools\Api\Model\Legacy\LegacyResourceDefaults

	- greeny\SatisfactoryTools\Api\Model\Legacy\LegacyRequestFactory

	- greeny\SatisfactoryTools\Api\Model\Legacy\LegacySolverService

	worldDataService:
		factory: greeny\SatisfactoryTools\Api\Model\Services\WorldDataService(
			generatorBin: %worldData.generatorBin%,
			worldFile: %worldData.worldFile%,
			timeout: %worldData.timeout%,
			cacheDir: %tempDir%/cache/world-data
		)

	- greeny\SatisfactoryTools\Api\Console\PublishCommand(wwwDir: %appDir%/../www)

	- greeny\SatisfactoryTools\Api\Console\PruneVersionFilesCommand(wwwDir: %appDir%/../www)

	- greeny\SatisfactoryTools\Api\Console\ImportLegacySharesCommand

	- greeny\SatisfactoryTools\Api\Console\SupportersSyncCommand

	- greeny\SatisfactoryTools\Api\Console\SupportersImportCommand

	- greeny\SatisfactoryTools\Api\Console\SupportersGrantCommand

	- greeny\SatisfactoryTools\Api\Console\SupportersRevokeCommand

	- greeny\SatisfactoryTools\Api\Model\Services\Supporters\SupporterHttpClient

	- greeny\SatisfactoryTools\Api\Model\Services\Supporters\SupporterEmailHasher

	- greeny\SatisfactoryTools\Api\Model\Services\Supporters\SupporterService

	- greeny\SatisfactoryTools\Api\Model\Services\Supporters\DiscordRoleService(
		botToken: %supporters.discord.botToken%,
		guildId: %supporters.discord.guildId%,
		roleId: %supporters.discord.roleId%
	)

	- greeny\SatisfactoryTools\Api\Model\Services\Errors\ClientErrorService

	- greeny\SatisfactoryTools\Api\Model\Services\Errors\DiscordErrorNotifier(
		botToken: %supporters.discord.botToken%,
		channelId: %errorReports.discordChannelId%
	)

	- greeny\SatisfactoryTools\Api\Model\Services\Supporters\PatreonTokenStore(
		file: %tempDir%/state/patreon-token.json,
		configAccessToken: %supporters.patreon.accessToken%,
		configRefreshToken: %supporters.patreon.refreshToken%
	)

	- greeny\SatisfactoryTools\Api\Model\Services\Supporters\PatreonClient(
		clientId: %supporters.patreon.clientId%,
		clientSecret: %supporters.patreon.clientSecret%,
		campaignId: %supporters.patreon.campaignId%,
		webhookSecret: %supporters.patreon.webhookSecret%
	)

	- greeny\SatisfactoryTools\Api\Model\Services\Supporters\PaypalClient(
		clientId: %supporters.paypal.clientId%,
		clientSecret: %supporters.paypal.clientSecret%,
		sandbox: %supporters.paypal.sandbox%
	)

	authService:
		factory: greeny\SatisfactoryTools\Api\Model\Services\AuthService(
			jwtSecret: %jwt.secret%,
			accessTokenTtl: %jwt.accessTokenTtl%,
			refreshTokenTtl: %jwt.refreshTokenTtl%
		)

	oauthDiscordProvider:
		factory: greeny\SatisfactoryTools\Api\Model\Services\OAuth\DiscordProvider(
			clientId: %oauth.discord.clientId%,
			clientSecret: %oauth.discord.clientSecret%
		)

	oauthGithubProvider:
		factory: greeny\SatisfactoryTools\Api\Model\Services\OAuth\GithubProvider(
			clientId: %oauth.github.clientId%,
			clientSecret: %oauth.github.clientSecret%
		)

	oauthGoogleProvider:
		factory: greeny\SatisfactoryTools\Api\Model\Services\OAuth\GoogleProvider(
			clientId: %oauth.google.clientId%,
			clientSecret: %oauth.google.clientSecret%
		)

	oauthSteamProvider:
		factory: greeny\SatisfactoryTools\Api\Model\Services\OAuth\SteamProvider(
			apiKey: %oauth.steam.apiKey%
		)

	oauthProviderRegistry:
		factory: greeny\SatisfactoryTools\Api\Model\Services\OAuth\OAuthProviderRegistry([
			@oauthDiscordProvider,
			@oauthGithubProvider,
			@oauthGoogleProvider,
			@oauthSteamProvider
		])

	oauthService:
		factory: greeny\SatisfactoryTools\Api\Model\Services\OAuth\OAuthService(
			registry: @oauthProviderRegistry,
			callbackBaseUrl: %oauth.callbackBaseUrl%,
			stateTtl: %oauth.stateTtl%
		)

	corsMiddleware:
		factory: greeny\SatisfactoryTools\Api\Utils\CorsMiddleware
		tags:
			middleware:
				priority: 10

	jwtMiddleware:
		factory: greeny\SatisfactoryTools\Api\Utils\JwtMiddleware
		tags:
			middleware:
				priority: 20
