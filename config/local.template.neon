parameters:
	jwtSecret: 'change-this-to-a-long-random-secret-at-least-32-chars'

	# The world file is intentionally not committed.
	worldDataGeneratorBin: '/path/to/world-data-generator/target/release/world-data-generator'
	worldDataWorldFile: '/path/to/world-data-generator/default-world.json'

	# The per-provider callback is this value + "/{provider}".
	oauthCallbackBaseUrl: 'https://tools.example.com/auth/callback'

	# Optional: public base URL of this API for link preview images (default: production).
	# publicApiUrl: 'https://api.sftools.local'

	# Optional: where GET /v1/legacy-shares/{slug} fetches shares that are not stored
	# locally (default: the old API). Set to '' to serve only the legacy_share table.
	# legacyShareSourceUrl: ''

	# Optional: the lp_solve binary and time limit of POST /v1/legacy-solver.
	# legacySolver:
	#     lpSolveBin: '/usr/local/bin/lp_solve'
	#     timeout: 30

	# See docs/oauth-provider-setup.md for how to obtain each of these.
	oauthDiscordClientId: ''
	oauthDiscordClientSecret: ''
	oauthGithubClientId: ''
	oauthGithubClientSecret: ''
	oauthGoogleClientId: ''
	oauthGoogleClientSecret: ''
	# Optional Steam Web API key (https://steamcommunity.com/dev/apikey), only used to read the persona name/avatar for display.
	oauthSteamApiKey: ''

nettrine.dbal:
	connections:
		default:
			user: root
			password:
