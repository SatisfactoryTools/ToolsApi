parameters:
	# Optional secrets default to empty so existing local.neon files keep working.
	oauthSteamApiKey: ''
	supporterPatreonAccessToken: ''
	supporterPatreonRefreshToken: ''
	supporterPatreonClientId: ''
	supporterPatreonClientSecret: ''
	supporterPatreonCampaignId: ''
	supporterPatreonWebhookSecret: ''
	supporterPaypalClientId: ''
	supporterPaypalClientSecret: ''
	supporterPaypalSandbox: false
	supporterDiscordBotToken: ''
	supporterDiscordGuildId: ''
	supporterDiscordRoleId: ''
	errorReportDiscordChannelId: ''

	# Public base URL of this API, for absolute image URLs in link previews (GET /v1/meta).
	# Not derived from the request: the caller is the frontend's index.php, not a browser.
	publicApiUrl: 'https://api.new.satisfactorytools.com'

	# Share endpoint of the old Satisfactory Tools API. GET /v1/legacy-shares/{slug} fetches
	# {url}{slug}/ from there when the slug is not in legacy_share (or the table does not
	# exist yet) and stores what it got. Empty string disables the fallback, e.g. once the
	# old API is gone and the import has run.
	legacyShareSourceUrl: 'https://api.satisfactorytools.com/v2/share/'

	legacySolver:
		# The old solver's LP engine (POST /v1/legacy-solver). An absolute path, so it is
		# found whatever PATH the web server runs with.
		lpSolveBin: '/usr/bin/lp_solve'
		timeout: 30               # seconds before a calculation is aborted (504)

	# Per client IP (IPv6 per /64). Counted in the rate_limit table; a request over the limit gets 429 + Retry-After.
	# Login is counted per IP + login, and on top of that a login is locked out with a doubling delay
	# (30 s up to 15 min) after 5 failed attempts in a row.
	rateLimits:
		login: {limit: 10, window: 900}
		register: {limit: 5, window: 3600}
		forgotPassword: {limit: 5, window: 3600}
		oauthStart: {limit: 30, window: 600}
		createVersion: {limit: 30, window: 3600}
		worldData: {limit: 30, window: 600}         # generator runs only, cached results are free
		anonymousShare: {limit: 30, window: 3600}   # shares sent as a tree; sharing your own stored plans is not limited
		clientError: {limit: 60, window: 3600}
		legacySolver: {limit: 60, window: 600}
		legacyShareFetch: {limit: 30, window: 600}  # fetches from the old API only, stored shares are free

	# Limits applied by RateLimitMiddleware before routing; the rest are checked in code where only some
	# requests count (see rateLimits comments).
	rateLimitRoutes:
		register: 'POST /v1/auth/register'
		forgotPassword: 'POST /v1/auth/forgot-password'
		oauthStart: 'POST /v1/auth/oauth/*/start'
		createVersion: 'POST /v1/versions'
		clientError: 'POST /v1/errors'
		legacySolver: 'POST /v1/legacy-solver'

	quotas:
		plans: 2000                 # per user, all versions together
		folders: 1000               # per user, all versions together
		mods: 50                    # per user
		modVersions: 100            # per mod
		customVersionsPerUser: 20   # custom versions a signed-in user ever created
		customVersionsPerIp: 10     # custom versions created from one IP in the last 24 hours

	requestBody:
		maxBytes: 5242880           # 5 MB
		overrides:
			'POST /v1/help/editor/images': 8388608   # 4 MB screenshots arrive base64-encoded

	jwt:
		secret: %jwtSecret%
		accessTokenTtl: 3600      # 1 hour
		refreshTokenTtl: 2592000  # 30 days
	worldData:
		generatorBin: %worldDataGeneratorBin%
		worldFile: %worldDataWorldFile%
		timeout: 60               # seconds

	# Supporter matching (see readme "Supporters"). A source without credentials is skipped.
	supporters:
		patreon:
			accessToken: %supporterPatreonAccessToken%
			refreshToken: %supporterPatreonRefreshToken%
			clientId: %supporterPatreonClientId%
			clientSecret: %supporterPatreonClientSecret%
			campaignId: %supporterPatreonCampaignId%
			webhookSecret: %supporterPatreonWebhookSecret%
		paypal:
			clientId: %supporterPaypalClientId%
			clientSecret: %supporterPaypalClientSecret%
			sandbox: %supporterPaypalSandbox%
		discord:
			botToken: %supporterDiscordBotToken%
			guildId: %supporterDiscordGuildId%
			roleId: %supporterDiscordRoleId%

	# Frontend errors (POST /v1/errors) are posted to this channel by the supporter Discord bot.
	errorReports:
		discordChannelId: %errorReportDiscordChannelId%

	oauth:
		callbackBaseUrl: %oauthCallbackBaseUrl%
		stateTtl: 600             # 10 minutes
		discord:
			clientId: %oauthDiscordClientId%
			clientSecret: %oauthDiscordClientSecret%
		github:
			clientId: %oauthGithubClientId%
			clientSecret: %oauthGithubClientSecret%
		google:
			clientId: %oauthGoogleClientId%
			clientSecret: %oauthGoogleClientSecret%
		steam:
			# Optional, only used to read the persona name and avatar for display (sign-in needs no credentials).
			apiKey: %oauthSteamApiKey%

php:
	date.timezone: Europe/Prague

api:
	debug: %debugMode%
	catchException: true
	plugins:
		Apitte\Middlewares\DI\MiddlewaresPlugin:
		Apitte\Console\DI\ConsolePlugin:
		Apitte\Core\DI\Plugin\CoreMappingPlugin:
			types:
				uuid: greeny\SatisfactoryTools\Api\Utils\UuidTypeMapper

decorator:
	Doctrine\ORM\Configuration:
		setup:
			- setTypedFieldMapper

di:
	export:
		parameters: no
		tags: no

extensions:
	api: Apitte\Core\DI\ApiExtension
	console: Contributte\Console\DI\ConsoleExtension(%consoleMode%)
	middleware: Contributte\Middlewares\DI\MiddlewaresExtension
	nettrine.dbal: Nettrine\DBAL\DI\DbalExtension
	nettrine.orm: Nettrine\ORM\DI\OrmExtension
	psr6: Contributte\Psr6\DI\Psr6CachingExtension

middleware:
	debug: %debugMode%

nettrine.dbal:
	debug:
		panel: %debugMode%
	types:
		uuid: Ramsey\Uuid\Doctrine\UuidType
	connections:
		default:
			driver: mysqli
			user: root
			password:
			dbname: sftools

nettrine.orm:
	managers:
		default:
			connection: default
			defaultCache: Contributte\Psr6\CachePool(
				Nette\Caching\Cache(
					Nette\Caching\Storages\FileStorage(%tempDir%/cache)
					doctrine/orm
				)
			)
			lazyNativeObjects: true
			mapping:
				Api:
					directories: [%appDir%/Model/Entities]
					namespace: greeny\SatisfactoryTools\Api

session:
	expiration: 30 days
