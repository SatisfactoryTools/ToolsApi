www/data/help/*
!www/data/help/.htaccess
!www/data/help/images/
www/data/help/images/*
!www/data/help/images/.htaccess
!www/data/maps/
www/data/maps/*
!www/data/maps/.htaccess
!www/data/world/
www/data/world/*
!www/data/world/.htaccess
www/desktop/*
!www/desktop/.htaccess
