# IDEs
.idea
.claude

# general
!.gitignore
!.gitkeep
!.htaccess

# app
maintenance.flag
log/*
temp/*
vendor/*
config/local.neon

# generated / runtime data
www/data/*
!www/data/.gitkeep
!www/data/.htaccess
!www/data/versions/
www/data/versions/*
!www/data/versions/custom/
www/data/versions/custom/*
!www/data/versions/custom/.htaccess
!www/data/help/
www/data/help/*
!www/data/help/.htaccess
!www/data/help/images/
www/data/help/images/*
!www/data/help/images/.htaccess
